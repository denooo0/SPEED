__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/
.venv/
venv/
env/

# Local config & secrets
config.local.yaml
.env
.env.*
# ...but the credential-less template must be tracked, or nobody knows what to fill in.
!*.env.example
!.env.example

# Runtime artifacts
logs/*.log
logs/*.log.*
database/*.db
database/*.db.backup
*.bak

# Phase 0 historical data store — keep the dir, exclude the parquet payloads
data/**/*.parquet
data/*.parquet
!data/.gitkeep
!data/regimes/.gitkeep

# Track F experiment storage — keep the dirs, exclude the payloads
experiments/log/*.json
experiments/*.parquet
!experiments/.gitkeep
!experiments/log/.gitkeep

# Inbox CSV drops — GitHub web upload commits them explicitly (bypasses this),
# but keep them out of routine local commits. Keep the folder + docs.
inbox/*.csv
inbox/*.CSV
!inbox/.gitkeep
!inbox/README.md

# Editor / OS
.vscode/
.idea/
.DS_Store

# Local Claude state (agent worktrees, local settings)
.claude/

# Copilot live journal (personal trade data)
memory/copilot/*.jsonl

# --- colosseum ---------------------------------------------------------------
# Telegram session files are CREDENTIALS. Holding one is holding the account —
# no password, no 2FA prompt. Never let these near a commit.
*.session
*.session-journal

# MIRROR archives: other people's channel content, and large. `deletions.jsonl`
# is the survivorship evidence — back it up somewhere, just not in git.
mirror_data/
deletions.jsonl

# Engine runtime state (ledger, WAL, journals, generated sessions/retros).
# colosseum/sample_output/ is deliberately NOT ignored — it is checked-in
# reference output showing what a run should look like.
colosseum_state/
colosseum.json
colosseum/**/__pycache__/


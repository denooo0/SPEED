# Copy to `.env` at the repo root and fill in. NEVER commit the real file.
#
#   cp colosseum/.env.example .env
#
# Get api_id / api_hash from https://my.telegram.org
#   -> log in with your phone -> "API development tools" -> create an app.
#
# SECURITY: the `.session` file created on first login is ALSO a credential.
# Anyone holding it has your Telegram account without needing your password or
# your 2FA code. It is gitignored; keep it that way, and treat it exactly like
# a password if you ever move it between machines.

TG_API_ID=
TG_API_HASH=

# Comma-separated, no spaces. Public @handles or numeric channel IDs.
TG_CHANNELS=@channel_one,@channel_two

# Where the archive is written. Gitignored — it is other people's content and
# it can get large.
MIRROR_DATA_DIR=mirror_data
